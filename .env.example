# Application Settings
PROJECT_NAME="Enterprise Document Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="change-this-ultra-secret-key-in-production-environments"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="ocr_user"
POSTGRES_PASSWORD="ocr_password"
POSTGRES_DB="document_intelligence"
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=False
MINIO_BUCKET_NAME="documents"

# Redis & Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="document_chunks"

# OCR Engine Configuration
OCR_MODE_AUTO_SWITCH_DPI_THRESHOLD=400
OCR_GUNDAM_MAX_IMAGE_SIDE=4096
OCR_MAX_WORKERS=4

# Embeddings & Reranker
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
RERANKER_MODEL_NAME="BAAI/bge-reranker-v2-m3"
